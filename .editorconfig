# 统一编辑器行为 / Editor configuration
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 8

# 文档与配置习惯两格缩进 / Two spaces for docs and configs
[*.{md,yml,yaml,json}]
indent_size = 2
trim_trailing_whitespace = false

[*.sh]
indent_size = 8
end_of_line = lf

# 链接脚本对齐用空格 / Linker scripts align with spaces
[*.ld]
indent_size = 8

[Makefile]
indent_style = tab
